# DART Open API (main.py, ipo_main.py 필수)
DART_API_KEY=your-dart-api-key

# Telegram Bot (실제 알림 발송 시 필수)
TELEGRAM_TOKEN=your-telegram-token
CHAT_ID=your-chat-id

# Google Gemini API (기본 AI 엔진: 공시 요약 / IPO 분석 / 미국 주식 밸류체인·SEC 레이더)
# https://aistudio.google.com/apikey 에서 무료 발급 가능
GEMINI_API_KEY=your-gemini-api-key

# Claude API 요약 (선택: config.json의 summary.method="claude" 일 때만 사용)
# ANTHROPIC_API_KEY=your-anthropic-api-key
