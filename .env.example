# DART API
DART_API_KEY=your-dart-api-key

# Telegram Bot
TELEGRAM_TOKEN=your-telegram-token
CHAT_ID=your-chat-id

# 네이버 뉴스 API (뉴스 알림 사용 시)
# https://developers.naver.com 에서 애플리케이션 등록 후 발급
# NAVER_CLIENT_ID=your-naver-client-id
# NAVER_CLIENT_SECRET=your-naver-client-secret

# Google Gemini API 요약 (기본값, config summary.method=gemini 일 때)
# https://aistudio.google.com/apikey 에서 무료 발급 가능
GEMINI_API_KEY=your-gemini-api-key

# Claude API 요약 (선택, config summary.method=claude 일 때)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI 요약 (선택, config news.summary.method=openai 일 때)
# OPENAI_API_KEY=your-openai-api-key
